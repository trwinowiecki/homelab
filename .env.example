# Arrstack environment template — copy to .env and fill in real values.
# Never commit .env (gitignored).

COMPOSE_PROJECT_NAME=arr_zinthos

DOCKER_SUBNET=172.28.10.0/24
DOCKER_GATEWAY=172.28.10.1
LOCAL_SUBNET=<lan-cidr>
LOCAL_DOCKER_IP=<arrstack-host>

TP_THEME=blackberry-martian
TP_COMMUNITY_THEME=true

FOLDER_FOR_MEDIA=/mnt/media
FOLDER_FOR_DOWNLOADS=/arrstack/downloads
FOLDER_FOR_DATA=/arrstack/config

PUID=10000
PGID=10000
UMASK=0002
TIMEZONE=America/New_York

# VPN (qBittorrent only) — NordVPN OpenVPN **service credentials**
# Nord Account → NordVPN → Set up manually → Service credentials tab.
# NOT your login email/password. Regenerating creds in Nord invalidates the old pair.
VPN_TYPE=openvpn
VPN_SERVICE_PROVIDER=nordvpn
VPN_USERNAME=CHANGE_ME
VPN_PASSWORD=CHANGE_ME
SERVER_COUNTRIES="United States"
SERVER_REGIONS=
SERVER_CITIES=
SERVER_HOSTNAMES=
SERVER_CATEGORIES=
OPENVPN_CUSTOM_CONFIG=
OPENVPN_PROTOCOL=udp
GLUETUN_CONTROL_PORT=8320
VPN_ENDPOINT_IP=
VPN_ENDPOINT_PORT=
WIREGUARD_PUBLIC_KEY=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=10.5.0.2/32

# Download clients
QBIT_PORT=6881
FLARESOLVERR_PORT=8191

# Web UI ports (host)
WEBUI_PORT_BAZARR=6767
WEBUI_PORT_HOMEPAGE=3000
WEBUI_PORT_LIDARR=8686
WEBUI_PORT_PORTAINER=9000
WEBUI_PORT_PROWLARR=9696
WEBUI_PORT_QBITTORRENT=8200
WEBUI_PORT_RADARR=7878
WEBUI_PORT_SABNZBD=8100
WEBUI_PORT_SEERR=5055
WEBUI_PORT_SONARR=8989
WEBUI_PORT_BINDERY=8787
WEBUI_PORT_AUDIOBOOKSHELF=13378
WEBUI_PORT_MIXARR=3010
WEBUI_PORT_MEALIE=9925
WEBUI_PORT_MEALIE_OG_SYNC=9926

# Mealie — set true once to create the first admin account, then false
MEALIE_ALLOW_SIGNUP=false

# Mealie → OurGroceries sync (scripts/sync_mealie_ourgroceries.py)
MEALIE_API_TOKEN=
MEALIE_STAGING_LIST=Weekly Meals (staging)
MEALIE_OG_SYNC_TOKEN=
# OurGroceries creds live in ${FOLDER_FOR_DATA}/mealie-og-sync/credentials.env
# (not here — $ in passwords breaks Docker Compose .env interpolation)

# Identity / LAN HTTPS (Caddy + Authentik — see docs/identity/deploy.md)
IDENTITY_LAN_DOMAIN=<lan-domain>
MEALIE_BASE_URL=https://mealie.<lan-domain>
MIXARR_BASE_URL=https://mixarr.<lan-domain>
# Mealie OIDC — fill after Authentik OAuth app is created
MEALIE_OIDC_ENABLED=false
MEALIE_OIDC_CONFIGURATION_URL=
MEALIE_OIDC_CLIENT_ID=
MEALIE_OIDC_CLIENT_SECRET=
IDENTITY_CADDY_CA=/arrstack/identity/caddy-ca/root.crt

# Set true by ./deploy.sh identity (sync_identity_oauth_env.py) when Authentik secrets exist
AUDIOBOOKSHELF_OIDC_ENABLED=false

# Portainer OAuth — URLs set by arrstack bootstrap; enable only after testing OAuth login
PORTAINER_OAUTH_ENABLED=false

# Homepage (use real LAN hostname or IP; not example.com)
# Homepage — compose also appends ${LOCAL_DOCKER_IP}:${WEBUI_PORT_HOMEPAGE} and homepage.${IDENTITY_LAN_DOMAIN}
HOMEPAGE_ALLOWED_HOSTS=homepage,localhost,127.0.0.1,<arrstack-host>

# *arr API keys — set once in .env (openssl rand -hex 16). Deploy seeds config volumes
# from these values and syncs to arrstack.auto.env for sidecars.
SONARR_API_KEY=CHANGE_ME
RADARR_API_KEY=CHANGE_ME
LIDARR_API_KEY=CHANGE_ME
PROWLARR_API_KEY=CHANGE_ME
BAZARR_API_KEY=CHANGE_ME
SABNZBD_API_KEY=

# Bindery — seed only; also written to arrstack.auto.env on deploy
BINDERY_API_KEY=CHANGE_ME

# Homepage widgets — qBit API key (qbt_ prefix); seeded into qBittorrent.conf on deploy
QBITTORRENT_API_KEY=CHANGE_ME

# Seerr — set once in .env (openssl rand -hex 16); also passed as API_KEY to the container
SEERR_API_KEY=CHANGE_ME

# Jellyfin widget — optional override; default is jellyfin.apiKey from Seerr settings.json
JELLYFIN_API_KEY=

# TrueNAS Homepage widget — create a Readonly Admin API key (docs/hosts/truenas.md). Also copy into obsv/.env.
TRUENAS_API_KEY=

# Portainer widget — paste a token once, or set admin password to mint on bootstrap
PORTAINER_ADMIN_PASSWORD=
PORTAINER_API_KEY=

# Audiobookshelf — bootstrap script creates root user + API key
AUDIOBOOKSHELF_USERNAME=root
AUDIOBOOKSHELF_PASSWORD=CHANGE_ME

# Mixarr (Lidarr discovery) — generate: openssl rand -hex 32
MIXARR_SESSION_SECRET=CHANGE_ME
MIXARR_BASE_URL=https://mixarr.<lan-domain>

# Usenet (fill in after purchasing provider + indexer)
USENET_HOST=CHANGE_ME
USENET_PORT=563
USENET_USERNAME=CHANGE_ME
USENET_PASSWORD=CHANGE_ME
USENET_SSL=true
# Frugal's connection cap depends on the plan. 50 is a safe fast setting; going past the cap slows the queue.
USENET_CONNECTIONS=50

# Optional: NZB indexer API keys for Prowlarr bootstrap script
NZBGEEK_API_KEY=
DRUNKENSLUG_API_KEY=

# Tdarr (parked profile — docker compose --profile tdarr up -d)
TDARR_SERVER_PORT=8266
WEBUI_PORT_TDARR=8265
