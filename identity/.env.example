# Copy to identity/.env — never commit .env
TIMEZONE=America/New_York

# LAN split-horizon zone (AdGuard rewrites *.<lan-domain> → LOCAL_DOCKER_IP)
IDENTITY_LAN_DOMAIN=<lan-domain>
LOCAL_DOCKER_IP=<arrstack-host>

# Public zone for Pangolin tunnel (auth login only; no Pangolin SSO on this resource)
IDENTITY_PUBLIC_DOMAIN=<domain>

# Caddy published ports on CT 100
WEBUI_PORT_CADDY_HTTP=80
WEBUI_PORT_CADDY_HTTPS=443

# TLS: IDENTITY_ACME_DNS=true issues Let's Encrypt *.<lan-domain> via Cloudflare DNS-01.
# While false, Caddy uses its internal CA (browsers warn until you trust it).
# Public *.<domain> certs still come from Traefik on the VPS (HTTP-01).
IDENTITY_ACME_DNS=true
CADDY_ACME_EMAIL=admin@<lan-domain>
CLOUDFLARE_API_TOKEN=
# Optional; Caddy DNS-01 does not use the account id.
CLOUDFLARE_ACCOUNT_ID=

# Authentik — generate: openssl rand -base64 36 | tr -d '\n'
AUTHENTIK_SECRET_KEY=CHANGE_ME
AUTHENTIK_POSTGRESQL__PASSWORD=CHANGE_ME
# First-boot only (empty Postgres). Admin username is always akadmin; email is set from BOOTSTRAP_EMAIL.
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME
AUTHENTIK_BOOTSTRAP_EMAIL=admin@<lan-domain>

# Forward-auth proxy provider slug (blueprint-proxy.yaml; default-provider is fine)
AUTHENTIK_PROXY_PROVIDER_SLUG=default-provider

# Authentik blueprints (auto-filled by scripts/merge_identity_env.py on deploy)
AUTHENTIK_OIDC_MEALIE_CLIENT_SECRET=
AUTHENTIK_OIDC_GRAFANA_CLIENT_SECRET=
AUTHENTIK_OIDC_AUDIOBOOKSHELF_CLIENT_SECRET=
AUTHENTIK_OIDC_PORTAINER_CLIENT_SECRET=
AUTHENTIK_OIDC_PANGOLIN_CLIENT_SECRET=
LDAP_OUTPOST_TOKEN=
LDAP_JELLYFIN_BIND_TOKEN=

# Pangolin OIDC — paste redirect URI from Pangolin Admin after creating IdP (see docs/identity/pangolin-oidc.md)
OAUTH_PANGOLIN_REDIRECT_URI=

# Optional: same Discord webhook as obsv/.env (Authentik appends /slack if missing)
AUTHENTIK_DISCORD_WEBHOOK_URL=