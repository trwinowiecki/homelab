# yaml-language-server: $schema=https://goauthentik.io/blueprints/schema.json
# LDAP provider + Jellyfin app + outpost token — rendered by scripts/render_identity_blueprints.py

version: 1
metadata:
  name: homelab-ldap-jellyfin
  labels:
    blueprints.goauthentik.io/description: LDAP outpost for Jellyfin

entries:
  - model: authentik_providers_ldap.ldapprovider
    id: ldap-provider
    state: present
    identifiers:
      name: homelab-ldap
    attrs:
      name: homelab-ldap
      authorization_flow: !Find [authentik_flows.flow, [slug, homelab-ldap-authentication-flow]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-invalidation-flow]]
      base_dn: dc=ldap,dc=goauthentik,dc=io
      bind_mode: direct
      search_mode: direct
      mfa_support: false
      gid_start_number: 4000
      uid_start_number: 2000
      search_group: !Find [authentik_core.group, [name, jellyfin_users]]
    permissions:
      - permission: search_full_directory
        user: !Find [authentik_core.user, [username, ldap_service_account]]

  - model: authentik_core.application
    id: jellyfin-ldap-application
    state: present
    identifiers:
      slug: jellyfin-ldap
    attrs:
      name: Jellyfin LDAP
      slug: jellyfin-ldap
      policy_engine_mode: any
      provider: !KeyOf ldap-provider

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf jellyfin-ldap-application
      order: 0
    attrs:
      target: !KeyOf jellyfin-ldap-application
      group: !Find [authentik_core.group, [name, jellyfin_users]]
      enabled: true

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf jellyfin-ldap-application
      order: 1
    attrs:
      target: !KeyOf jellyfin-ldap-application
      user: !Find [authentik_core.user, [username, ldap_service_account]]
      enabled: true

  - model: authentik_core.user
    id: ldap-jellyfin-sa-user
    state: present
    identifiers:
      username: ldap_service_account
    attrs:
      username: ldap_service_account
      name: Jellyfin LDAP service account
      path: users
      type: service_account
      is_active: true

  - model: authentik_core.token
    id: ldap-jellyfin-sa-token
    state: present
    identifiers:
      identifier: jellyfin-ldap-bind
      intent: app_password
    attrs:
      description: Jellyfin LDAP bind password
      user: !KeyOf ldap-jellyfin-sa-user
      key: "{{LDAP_JELLYFIN_BIND_TOKEN}}"

  - model: authentik_outposts.outpost
    id: ldap-outpost
    state: present
    identifiers:
      name: homelab-ldap-outpost
    attrs:
      name: homelab-ldap-outpost
      type: ldap
      providers:
        - !KeyOf ldap-provider
      config:
        authentik_host: http://authentik-server:9000
        authentik_host_insecure: true
        object_naming_template: ak-outpost-%(name)s
        log_level: info
      token_identifier: ldap-outpost-homelab
