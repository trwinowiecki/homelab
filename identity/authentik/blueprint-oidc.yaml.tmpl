# yaml-language-server: $schema=https://goauthentik.io/blueprints/schema.json
# Household/admin OIDC apps — rendered by scripts/render_identity_blueprints.py

version: 1
metadata:
  name: homelab-oidc-apps
  labels:
    blueprints.goauthentik.io/description: OIDC providers for Mealie, Grafana, Audiobookshelf, Portainer

entries:
  # --- Mealie (household) ---
  - model: authentik_providers_oauth2.oauth2provider
    id: mealie-provider
    state: present
    identifiers:
      name: homelab-mealie
    attrs:
      name: homelab-mealie
      client_type: confidential
      client_id: "{{OAUTH_MEALIE_CLIENT_ID}}"
      client_secret: "{{AUTHENTIK_OIDC_MEALIE_CLIENT_SECRET}}"
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      redirect_uris:
        - matching_mode: strict
          url: "{{OAUTH_MEALIE_REDIRECT_URI}}"
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]

  - model: authentik_core.application
    id: mealie-application
    state: present
    identifiers:
      slug: mealie
    attrs:
      name: Mealie
      slug: mealie
      policy_engine_mode: any
      provider: !KeyOf mealie-provider
      meta_launch_url: "https://mealie.{{IDENTITY_LAN_DOMAIN}}"

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf mealie-application
      order: 0
    attrs:
      target: !KeyOf mealie-application
      group: !Find [authentik_core.group, [name, household]]
      enabled: true

