# yaml-language-server: $schema=https://goauthentik.io/blueprints/schema.json
# Pangolin OIDC IdP — rendered when OAUTH_PANGOLIN_REDIRECT_URI is set in identity/.env

version: 1
metadata:
  name: homelab-oidc-pangolin
  labels:
    blueprints.goauthentik.io/description: OIDC provider for Pangolin VPN login

entries:
  - model: authentik_providers_oauth2.oauth2provider
    id: pangolin-provider
    state: present
    identifiers:
      name: homelab-pangolin
    attrs:
      name: homelab-pangolin
      client_type: confidential
      client_id: "{{OAUTH_PANGOLIN_CLIENT_ID}}"
      client_secret: "{{AUTHENTIK_OIDC_PANGOLIN_CLIENT_SECRET}}"
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      redirect_uris:
        - matching_mode: strict
          url: "{{OAUTH_PANGOLIN_REDIRECT_URI}}"
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]

  - model: authentik_core.application
    id: pangolin-application
    state: present
    identifiers:
      slug: pangolin
    attrs:
      name: Pangolin
      slug: pangolin
      policy_engine_mode: any
      provider: !KeyOf pangolin-provider
      meta_launch_url: "https://pangolin.{{IDENTITY_PUBLIC_DOMAIN}}"

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf pangolin-application
      order: 0
    attrs:
      target: !KeyOf pangolin-application
      group: !Find [authentik_core.group, [name, admin]]
      enabled: true

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf pangolin-application
      order: 1
    attrs:
      target: !KeyOf pangolin-application
      group: !Find [authentik_core.group, [name, vpn]]
      enabled: true
