# Copy to jellyfin/.env — never commit .env
TIMEZONE=America/New_York

# LAN address of CT 104 (Jellyfin Docker)
LOCAL_DOCKER_IP=<jellyfin-host>
WEBUI_PORT_JELLYFIN=8096

# Public URL clients should use (trial: LAN HTTPS; cutover: jellyfin.<domain>)
JELLYFIN_PUBLISHED_SERVER_URL=https://jellyfin.<domain>
# LAN still works via Caddy: https://jellyfin.<lan-domain> → <jellyfin-host>:8096

# Media library (must match paths in library.db when migrating from CT 101)
FOLDER_FOR_MEDIA=/mnt/media

# Jellyfin state on CT 104 SSD (not CIFS)
JELLYFIN_CONFIG_DIR=/arrstack/jellyfin/config

PUID=10000
PGID=10000

# First-boot admin (startup wizard) when config volume is empty
JELLYFIN_ADMIN_USER=admin
JELLYFIN_ADMIN_PASSWORD=CHANGE_ME

# Break-glass local user (Default auth). Created on bootstrap if missing.
JELLYFIN_LOCAL_ADMIN_USER=admin
JELLYFIN_LOCAL_ADMIN_PASSWORD=CHANGE_ME

# Optional override; otherwise read from config or minted at bootstrap
JELLYFIN_API_KEY=

# LDAP bind password (same as identity/.env → LDAP_JELLYFIN_BIND_TOKEN)
LDAP_JELLYFIN_BIND_TOKEN=
