# Copy to .env and fill secrets. Never commit .env.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME/CHANGE_ME
TIMEZONE=America/New_York
WEBUI_PORT_VICTORIALOGS=9428
WEBUI_PORT_VICTORIAMETRICS=8428
WEBUI_PORT_DOZZLE=8880
WEBUI_PORT_GRAFANA=3800
PUID=10000
PGID=10000
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Grafana OIDC (optional — after Authentik OAuth app; see docs/identity/deploy.md)
GF_AUTH_OIDC_ENABLED=false
GF_AUTH_OIDC_CLIENT_ID=
GF_AUTH_OIDC_CLIENT_SECRET=
GF_AUTH_OIDC_AUTH_URL=
GF_AUTH_OIDC_TOKEN_URL=
GF_AUTH_OIDC_API_URL=
GF_AUTH_OIDC_SIGNOUT_URL=
GF_AUTH_OIDC_AUTO_LOGIN=false
GF_SERVER_ROOT_URL=
GF_AUTH_ANONYMOUS_ENABLED=false
# Read-only PVE API token: pveum user token add root@pam obsv --privsep 1
# then pveum aclmod / -token 'root@pam!obsv' -role PVEAuditor
PVE_USER=root@pam
PVE_TOKEN_NAME=obsv
PVE_TOKEN_VALUE=CHANGE_ME
PVE_VERIFY_SSL=false
# Linode API token with account:read_only. CHANGE_ME disables the scrape payload (exporter still runs).
LINODE_TOKEN=CHANGE_ME
# TrueNAS read-only API key (same value as TRUENAS_API_KEY in repo-root .env). See docs/hosts/truenas.md.
TRUENAS_API_KEY=
