{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "bargauge",
      "title": "Dataset used vs snapshots vs free",
      "id": 1,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "expr": "truenas_dataset_used_bytes",
          "legendFormat": "{{dataset}} used",
          "refId": "A"
        },
        {
          "expr": "truenas_dataset_usedbysnapshots_bytes",
          "legendFormat": "{{dataset}} snapshots",
          "refId": "B"
        },
        {
          "expr": "truenas_dataset_available_bytes",
          "legendFormat": "{{dataset}} free",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient" }
    },
    {
      "type": "table",
      "title": "Largest library items",
      "id": 2,
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "expr": "topk(25, library_item_bytes)",
          "legendFormat": "{{app}} {{title}}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Value", "desc": true }] }
    },
    {
      "type": "table",
      "title": "Large and stale (unwatched or not watched in stale_days)",
      "id": 3,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "expr": "topk(25, library_item_bytes{stale=\"true\"})",
          "legendFormat": "{{title}}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          }
        ]
      }
    },
    {
      "type": "piechart",
      "title": "Size by quality profile",
      "id": 4,
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "expr": "sum by (app, profile) (library_item_bytes)",
          "legendFormat": "{{app}} {{profile}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } }
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": ["homelab", "obsv", "library"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "America/New_York",
  "title": "Library space",
  "uid": "library-space",
  "version": 1,
  "weekStart": ""
}
