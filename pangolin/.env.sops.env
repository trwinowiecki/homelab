# Pangolin server instance values. Copy to .env and fill in.
#
#   cp .env.example .env
#
# .env contains SERVER_SECRET and must never be committed. Everything in this
# file that is not a secret is safe to keep in git — the point of this directory
# is that the deployment can be recreated from it.
########################################
# DOMAIN
########################################
# Hostname for the Pangolin dashboard and API. Must have an A record pointing
# at the VPS before the first deploy, or Let's Encrypt will fail.
PANGOLIN_DASHBOARD_DOMAIN=ENC[AES256_GCM,data:pxsvyk7ZjzXbxGHisSzZUVpmxGtN,iv:vc1SCyBAjewR4cNtd8oS1Kghn3mfhZKHaYtlvsW4CMg=,tag:qeAw+z05lwv1tV6Gz9DZDw==,type:str]
# Parent domain that published resources hang off, e.g. jellyfin.schwick.site.
PANGOLIN_BASE_DOMAIN=ENC[AES256_GCM,data:F9ATRtVe3JwnNPQm,iv:X+rMXVQb9IcxA7noWZReQqNNgJodmJhVu20EldfBMmI=,tag:e9GVCo+iPlbRpY7UMLJDzw==,type:str]
# Let's Encrypt registration address. Receives expiry warnings.
PANGOLIN_ACME_EMAIL=ENC[AES256_GCM,data:NDfO+zdU6c3vFIEGAKAhUkE=,iv:h0pKeQOaYw7631/X1kL1gbp3U/UR7W0BPnYc7JUv+k0=,tag:LpQGGgAyjzUCPzJkT50nsg==,type:str]
########################################
# SECRETS
########################################
# Encrypts sensitive data at rest. Generate with: openssl rand -hex 32
# Passed to the container as SERVER_SECRET so it never lands in config.yml.
# Changing this after first boot requires:
#   docker compose exec pangolin pangctl rotate-server-secret
SERVER_SECRET=ENC[AES256_GCM,data:JGrOz/PnYv8Hx1fdrgqgEE03fsNWVDfK8bqbGt9aizieQGYGugoTrvgrgacEXc2b9ulFLlUgyDa9BBxQZ10how==,iv:XYQAeVFZhcAK0d4QjSc0eGsKxi5bt0UBtJq0YNKU2Zo=,tag:Y/jadNJ3BJQyRGoaLbSSOg==,type:str]
########################################
# DEPLOY TARGET
########################################
# SSH destination for the VPS running the Pangolin server.
PANGOLIN_SSH_HOST=ENC[AES256_GCM,data:UTmU5oOgcVL7Q8B/Smsja20fMt4=,iv:WugvUKGMgmx+7AK5HurKjnXu7aUcjCGXfF1re94C21g=,tag:2C8NZywyQYtCHPmcAWC5Wg==,type:str]
# Directory on the VPS that deploy.sh writes to.
PANGOLIN_REMOTE_DIR=ENC[AES256_GCM,data:JoajRbrqUN6mrej2JQ==,iv:1cfRRIFP/LWNsvT7M2Jf5hQDXHiroSgWtKn+eUkGFzg=,tag:eczRmf2LJi2qbSkvR8oWzg==,type:str]
########################################
# IMAGE VERSIONS
########################################
# Pinned deliberately. `latest` would make the deployment unreproducible.
PANGOLIN_VERSION=ENC[AES256_GCM,data:ZMQs52R+,iv:KFvW46POxVXnD0V+/kBoPdydXICEhW6+5pgrzd6ihJ0=,tag:oPMM7AJM8U84CB9uP+abyw==,type:str]
GERBIL_VERSION=ENC[AES256_GCM,data:AI5OEao=,iv:NT8QsFk6ijAUiI/EzEW5x0dUYWzbvZ+mjlNcY7X7O64=,tag:cZMEbYWm5c+as0nFHKeqgw==,type:str]
TRAEFIK_VERSION=ENC[AES256_GCM,data:WH4nBg==,iv:bfCdFDT/iw+Q2SNQPV7XKZ5v7FO5aVhM+rKAcs+STew=,tag:Tb7YBV/A9HJuX1ELsYdrdg==,type:str]
# Traefik plugin that enforces Pangolin auth. Version is compiled in by Traefik
# at startup, so it is rendered into traefik_config.yml rather than compose.
BADGER_VERSION=ENC[AES256_GCM,data:DkhDbSfu,iv:/y9d18c6AMP4SqyiqcEFyNQmMmbQ3yx081M1cv3H/n8=,tag:Odl7aYl3kNJ7CWEngHeCYw==,type:str]
