# Newt site connector values. Copy to .env and fill in.
#
#   cp .env.example .env
#
# NEWT_SECRET is a credential — do not commit .env.

# Must match PANGOLIN_DASHBOARD_DOMAIN from ../.env.
PANGOLIN_DASHBOARD_DOMAIN=pangolin.<domain>

# Generated by Pangolin when you create the site (Sites > Add Site > Newt).
NEWT_ID=
NEWT_SECRET=

NEWT_VERSION=1.15.0

########################################
# DEPLOY TARGET
########################################

# CT 103 on pve, built specifically to run this connector.
SITE_SSH_HOST=root@<newt-host>
SITE_REMOTE_DIR=/opt/pangolin-site
