# Copy to /root/homelab-backup/restic.env on pve. Do not commit a filled copy.
#
# The repo lives on TrueNAS, mounted on pve at RESTIC_REPOSITORY's parent.
# Password file is /root/.restic-password (mode 0600) and must also live in a
# password manager — if pve dies, the repo on TrueNAS is unreadable without it.

RESTIC_REPOSITORY=/mnt/lxc_shares/metrion/backups/restic
RESTIC_PASSWORD_FILE=/root/.restic-password
RESTIC_COMPRESSION=auto
